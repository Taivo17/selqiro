      "policies": [
        {
          "name": "controlled_writer",
          "check": "true",
          "roles": [
            "selqiro_listing_contact_writer_v1"
          ],
          "using": "true",
          "command": "*",
          "permissive": true
        }
      ],
      "force_rls": false,
      "constraints": [
        {
          "name": "photos_actor_user_id_request_key_key",
          "type": "u",
          "validated": true,
          "definition": "UNIQUE (actor_user_id, request_key)"
        },
        {
          "name": "photos_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((((upload_key IS NULL) AND (web_sha256 IS NULL) AND (web_bytes IS NULL) AND (width IS NULL) AND (height IS NULL)) OR ((upload_key IS NOT NULL) AND (web_sha256 IS NOT NULL) AND (web_bytes IS NOT NULL) AND (width IS NOT NULL) AND (height IS NOT NULL))))"
        },
        {
          "name": "photos_check1",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((state <> ALL (ARRAY['uploading'::text, 'ready'::text, 'attached'::text])) OR (upload_key IS NOT NULL)))"
        },
        {
          "name": "photos_check2",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((state = 'attached'::text) = (message_id IS NOT NULL)))"
        },
        {
          "name": "photos_check3",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((state = 'tombstoned'::text) OR ((cleanup_key IS NULL) AND (cleanup_lease_until IS NULL) AND (next_cleanup_at IS NULL))))"
        },
        {
          "name": "photos_check4",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((cleanup_key IS NULL) = (cleanup_lease_until IS NULL)))"
        },
        {
          "name": "photos_check5",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((expires_at > created_at))"
        },
        {
          "name": "photos_cleanup_attempts_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((cleanup_attempts >= 0))"
        },
        {
          "name": "photos_conversation_id_fkey",
          "type": "f",
          "validated": true,
          "definition": "FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE RESTRICT"
        },
        {
          "name": "photos_failure_code_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((failure_code ~ '^[A-Z0-9_]{1,64}$'::text))"
        },
        {
          "name": "photos_height_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((height >= 1) AND (height <= 1600)))"
        },
        {
          "name": "photos_message_id_fkey",
          "type": "f",
          "validated": true,
          "definition": "FOREIGN KEY (message_id) REFERENCES messages(id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED"
        },
        {
          "name": "photos_message_id_key",
          "type": "u",
          "validated": true,
          "definition": "UNIQUE (message_id)"
        },
        {
          "name": "photos_pkey",
          "type": "p",
          "validated": true,
          "definition": "PRIMARY KEY (attachment_id)"
        },
        {
          "name": "photos_request_key_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((request_key <> '00000000-0000-0000-0000-000000000000'::uuid))"
        },
        {
          "name": "photos_source_bytes_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((source_bytes >= 1) AND (source_bytes <= 1400000)))"
        },
        {
          "name": "photos_source_mime_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((source_mime = 'image/webp'::text))"
        },
        {
          "name": "photos_source_sha256_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((source_sha256 ~ '^[0-9a-f]{64}$'::text))"
        },
        {
          "name": "photos_state_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((state = ANY (ARRAY['reserved'::text, 'uploading'::text, 'ready'::text, 'attached'::text, 'tombstoned'::text])))"
        },
        {
          "name": "photos_web_bytes_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((web_bytes >= 1) AND (web_bytes <= 2000000)))"
        },
        {
          "name": "photos_web_sha256_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((web_sha256 ~ '^[0-9a-f]{64}$'::text))"
        },
        {
          "name": "photos_width_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (((width >= 1) AND (width <= 1600)))"
        }
      ]
