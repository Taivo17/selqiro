        "CREATE INDEX photos_cleanup_v2 ON messaging_private_v2.photos USING btree (state, next_cleanup_at, expires_at)",
        "CREATE UNIQUE INDEX photos_message_id_key ON messaging_private_v2.photos USING btree (message_id)",
        "CREATE UNIQUE INDEX photos_pkey ON messaging_private_v2.photos USING btree (attachment_id)"
