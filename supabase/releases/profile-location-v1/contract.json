    "prepare_profile_location_v1",
    "reserve_profile_location_lookup_v1"
  ],
  "authenticated_only": [
    "get_my_profile_editor_v2",
    "save_my_profile_editor_v2"
  ],
  "selection_ttl_seconds": 900,
  "selection_active_limit_per_user": 20,
